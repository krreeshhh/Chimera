# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Generate a random secure string to verify incoming webhook requests from Telegram
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Image Processing Configuration Limits
# Maximum input file size allowed for processing (in Megabytes)
MAX_FILE_SIZE_MB=20
# Maximum output file size allowed (in Megabytes)
MAX_OUTPUT_SIZE_MB=50
# Maximum image resolution in pixels (e.g. 4194304 = 4 Megapixels, i.e. 2000x2000)
MAX_IMAGE_PIXELS=4194304

# Model Cache Configuration (Optional, defaults to /tmp/transformers-cache)
TRANSFORMERS_CACHE=/tmp/transformers-cache
